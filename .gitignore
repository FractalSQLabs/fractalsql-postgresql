# Build artifacts
*.so
*.o
*.bc
*.bc.tmp
*.a
*.dylib
*.pdb
fractalsql.so
fractal_pg*.so

# MSI packaging intermediates (scripts/windows/build-msi.bat)
obj/
*.wixobj

# Python bytecode caches (tests/, scripts/ci/, anywhere else)
__pycache__/
*.pyc

# build_test.sh --coverage artifacts
*.gcno
*.gcda
*.gcov
coverage_html/
coverage_html_mcp/

# NOTE: include/sfs_core_bc.h is a tracked source file
# (pre-compiled LuaJIT bytecode). Do not add it to this list.

# NOTE: include/ also vendors the foundry's built core archives/shared
# objects (checked in deliberately, per fleet convention — CI and
# consumers build against a pinned drop, not a from-source fetch).
# The blanket *.a/*.so/*.dylib rules above would otherwise silently
# exclude them even after `git add include/`. Un-ignore explicitly.
!include/**/*.a
!include/**/*.so
!include/**/*.dylib

# Stray scratch dirs under include/ for local-only manual testing (e.g.
# staging an enterprise-tier .dll/.sig to validate fractalsql.enterprise_lib
# against a real build) -- must never be committed into this Apache-2.0
# tree; `git add -A` will otherwise sweep them up like any other new file.
include/*/tmp/

# Build output trees
dist/

# PGXS-generated artifacts
fractalsql--*.sql.in
libfractalsql.pc
results/
tmp_check/
regression.diffs
regression.out

# Packaging temp files (fpm + debhelper + rpmbuild stagedirs)
*.deb
*.rpm
packaging/debian/.debhelper/
packaging/debian/postgresql-*-fractalsql/
packaging/debian/files
packaging/debian/*.log
packaging/debian/*.substvars
packaging/rpm/BUILD/
packaging/rpm/BUILDROOT/
packaging/rpm/RPMS/
packaging/rpm/SOURCES/
packaging/rpm/SPECS/
packaging/rpm/SRPMS/

# Benchmark harness (Python, psycopg + HNSW)
bench/__pycache__/
bench/**/__pycache__/
bench/*.pyc
bench/.pytest_cache/
bench/data/

fsql_setup.sql

# Editor / OS cruft
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# MCP server build artifacts (the C++17 plugin's own Makefile / cl output).
# NEVER ignored: mcp/.mcp-schema-lock, mcp/.mcp-safety-annotations-lock,
# mcp/manifest.json, mcp/vendor/json.hpp -- all four are committed per the
# MCP plugin spec (10.5 supply-chain pinning + 15.3/15.5 artifacts).
mcp/obj/
mcp/*.exe
mcp/fractalsql-postgresql-mcp
mcp/err.txt

# Local TLS-wiring scratch artifacts (openssl key/cert/config + the
# server log) produced when hand-testing the MCP server's HTTPS mode
# against a throwaway self-signed pair. These are LOCAL-ONLY and must
# never be committed: two of them are PRIVATE KEYS, and a third is a
# live server log. The MCP plugin's own committed TLS material, if any,
# lives under mcp/ and is tracked deliberately.
mcp_https_*.pem
mcp_https_*.key
mcp_https_*.cnf
mcp_https_*.log

# mcp/Makefile -MMD dependency files
mcp/src/*.d
mcp/src/adapters/*.d
